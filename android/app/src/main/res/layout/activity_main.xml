<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Native (non-WebRTC) path: MediaCodec renders straight into this surface. -->
    <SurfaceView
        android:id="@+id/nativeVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Idle / lobby screen -->
    <LinearLayout
        android:id="@+id/idlePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Receiver ready. Open WebRTC Bench on your PC."
            android:textColor="@color/accent"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="720dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/addrText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="DESKTOPS ON THIS NETWORK"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/desktopsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="PAIRED DESKTOPS"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pairedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text"
                android:textSize="17sp" />
        </LinearLayout>

        <Button
            android:id="@+id/forgetButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/button_bg"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="Forget paired desktops"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Live stats while a test runs -->
    <TextView
        android:id="@+id/overlayText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:background="@color/overlay_bg"
        android:fontFamily="monospace"
        android:padding="14dp"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Pairing PIN, over a dimmed backdrop -->
    <FrameLayout
        android:id="@+id/pinPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6050709"
        android:clickable="true"
        android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="40dp"
        android:paddingEnd="64dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/pinTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/pinText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:textColor="@color/accent"
            android:textSize="88sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Enter this PIN in WebRTC Bench on your PC. Press Back to cancel."
            android:textColor="@color/muted"
            android:textSize="16sp" />
    </LinearLayout>
    </FrameLayout>
</FrameLayout>
